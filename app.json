{
  "expo": {
    "name": "IW3IPWallet",
    "slug": "iw3ip-wallet",
    "version": "0.8.1",
    "orientation": "portrait",
    "entryPoint": "index.js",
    "scheme": "jp.ac.nagoya-u.ertl.iw3ip.wallet",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.ac.nagoya-u.ertl.iw3ip.wallet",
      "useFrameworks": "static",
      "associatedDomains": [],
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan QR codes for receiving and presenting credentials"
      }
    },
    "android": {
      "package": "jp.ac.nagoya_u.ertl.iw3ip.wallet",
      "intentFilters": []
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#202537"
    },
    "extra": {},
    "plugins": [
      "@animo-id/expo-ausweis-sdk",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31,
            "useLegacyPackaging": true,
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-asset",
      "expo-localization",
      "./withSphereonWalletPods"
    ]
  }
}
